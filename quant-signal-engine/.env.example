# ============================================================
# Copia este archivo a .env y rellena SOLO lo que uses.
# NUNCA subas .env a GitHub (está gitignored y gitleaks lo vigila).
# Ninguna API key es obligatoria: sin ellas el sistema usa fallbacks.
# ============================================================

# FRED (macro). Sin key, VIX/DXY/curva usan yfinance como fallback.
# Obtén una gratis en https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Glassnode (on-chain, tier free). Opcional.
GLASSNODE_API_KEY=

# Telegram (notificaciones opcionales de señales/alertas)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Kill switch global: cualquier valor distinto de "" detiene TODAS las señales
# (alternativa: crear un archivo llamado KILL_SWITCH en la raíz del repo)
QSE_KILL_SWITCH=

# Permitir datos sintéticos SOLO para demos/tests locales (--offline).
# En producción déjalo vacío: si fallan las fuentes, la señal es NADA.
QSE_ALLOW_SYNTHETIC=
